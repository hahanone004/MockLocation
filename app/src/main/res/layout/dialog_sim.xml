<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/config_content_background"
    android:orientation="vertical"
    android:padding="12dp">

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_sim_enabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/switch_panel_background"
        android:minHeight="64dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/switch_enable_sim"
        android:textColor="@color/app_on_surface"
        android:textSize="15sp" />

    <TextView style="@style/FieldLabel" android:text="@string/field_sim_country" />
    <TextView
        android:id="@+id/field_sim_country"
        style="@style/FieldInput"
        android:layout_marginTop="6dp"
        android:background="@drawable/select_field_background"
        android:clickable="true"
        android:drawableEnd="@drawable/baseline_chevron_right_24"
        android:drawableTint="@color/app_on_surface_variant"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp" />

    <TextView style="@style/FieldLabel" android:text="@string/field_sim_carrier" />
    <TextView
        android:id="@+id/field_sim_carrier"
        style="@style/FieldInput"
        android:layout_marginTop="6dp"
        android:background="@drawable/select_field_background"
        android:clickable="true"
        android:drawableEnd="@drawable/baseline_chevron_right_24"
        android:drawableTint="@color/app_on_surface_variant"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_locale_enabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/switch_panel_background"
        android:minHeight="64dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/app_on_surface"
        android:textSize="15sp"
        tools:text="同时把系统语言报成简体中文" />

    <TextView style="@style/FieldLabel" android:text="@string/sim_generated_title" />
    <TextView
        android:id="@+id/sim_summary"
        style="@style/FieldInput"
        android:layout_marginTop="6dp"
        android:background="@drawable/switch_panel_background"
        android:lineSpacingExtra="3dp"
        android:padding="16dp"
        android:textColor="@color/app_on_surface_variant"
        android:textSize="14sp"
        tools:text="网络国家码：CN\n网络运营商：46000\n网络运营商名称：中国移动" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/AppTextInputLayout"
        android:hint="@string/field_phone_number">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/field_phone_number"
            style="@style/FieldInput"
            android:inputType="phone"
            tools:ignore="Autofill" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/AppTextInputLayout"
        android:hint="@string/field_sim_serial">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/field_sim_serial"
            style="@style/FieldInput"
            android:inputType="number"
            tools:ignore="Autofill" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action_regenerate"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/action_regenerate" />

    <TextView style="@style/FieldLabel" android:text="@string/sim_locale_hint" />
    <TextView style="@style/FieldLabel" android:text="@string/sim_hint" />
</LinearLayout>
