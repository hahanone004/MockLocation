<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_location_enabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/switch_panel_background"
        android:minHeight="64dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/switch_enable_location"
        android:textColor="@color/app_on_surface"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/AppTextInputLayout"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:hint="@string/field_latitude"
            app:endIconMode="clear_text">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/field_latitude"
                style="@style/FieldInput"
                android:inputType="numberDecimal|numberSigned"
                tools:ignore="Autofill" />
        </com.google.android.material.textfield.TextInputLayout>

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/AppTextInputLayout"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:hint="@string/field_longitude"
            app:endIconMode="clear_text">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/field_longitude"
                style="@style/FieldInput"
                android:inputType="numberDecimal|numberSigned"
                tools:ignore="Autofill" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/AppTextInputLayout"
        android:hint="@string/field_offset"
        app:suffixText="m">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/field_offset"
            style="@style/FieldInput"
            android:inputType="numberDecimal"
            tools:ignore="Autofill" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        style="@style/FieldLabel"
        android:text="@string/field_offset_hint" />
</LinearLayout>
