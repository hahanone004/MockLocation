<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profile_item_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/app_surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:rippleColor="@color/brand_primary_container"
    app:strokeColor="@color/app_outline_variant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="78dp"
        android:orientation="horizontal"
        android:padding="14dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardBackgroundColor="@color/brand_primary_container"
            app:cardCornerRadius="15dp"
            app:cardElevation="0dp">
            <ImageView
                android:id="@+id/profile_item_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/baseline_layers_24"
                android:tint="@color/brand_primary" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/profile_item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/app_on_surface"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="上海" />
            <TextView
                android:id="@+id/profile_item_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/app_on_surface_variant"
                android:textSize="13sp"
                tools:text="位置 · 基站 · Wi-Fi · SIM" />
        </LinearLayout>

        <TextView
            android:id="@+id/profile_item_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/profile_chip_background"
            android:paddingStart="9dp"
            android:paddingTop="5dp"
            android:paddingEnd="9dp"
            android:paddingBottom="5dp"
            android:textColor="@color/brand_on_primary_container"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="默认"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/profile_item_trailing"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:src="@drawable/baseline_chevron_right_24"
            android:tint="@color/app_on_surface_variant" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
