<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/config_content_background"
    android:orientation="vertical"
    android:padding="12dp">

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_cell_enabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/switch_panel_background"
        android:minHeight="64dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/switch_enable_cell"
        android:textColor="@color/app_on_surface"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <com.google.android.material.textfield.TextInputLayout
            style="@style/AppTextInputLayout"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:hint="@string/field_mcc">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/field_mcc"
                style="@style/FieldInput"
                android:inputType="number"
                tools:ignore="Autofill" />
        </com.google.android.material.textfield.TextInputLayout>
        <Space android:layout_width="10dp" android:layout_height="1dp" />
        <com.google.android.material.textfield.TextInputLayout
            style="@style/AppTextInputLayout"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:hint="@string/field_mnc">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/field_mnc"
                style="@style/FieldInput"
                android:inputType="number"
                tools:ignore="Autofill" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <com.google.android.material.textfield.TextInputLayout
            style="@style/AppTextInputLayout"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:hint="@string/field_tac">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/field_tac"
                style="@style/FieldInput"
                android:inputType="number"
                tools:ignore="Autofill" />
        </com.google.android.material.textfield.TextInputLayout>
        <Space android:layout_width="10dp" android:layout_height="1dp" />
        <com.google.android.material.textfield.TextInputLayout
            style="@style/AppTextInputLayout"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:hint="@string/field_pci">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/field_pci"
                style="@style/FieldInput"
                android:inputType="number"
                tools:ignore="Autofill" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/AppTextInputLayout"
        android:hint="@string/field_eci">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/field_eci"
            style="@style/FieldInput"
            android:inputType="number"
            tools:ignore="Autofill" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="8dp"
        android:text="@string/field_eci_hint" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <com.google.android.material.textfield.TextInputLayout
            style="@style/AppTextInputLayout"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:hint="@string/field_enodeb">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/field_enodeb"
                style="@style/FieldInput"
                android:inputType="number"
                tools:ignore="Autofill" />
        </com.google.android.material.textfield.TextInputLayout>
        <Space android:layout_width="10dp" android:layout_height="1dp" />
        <com.google.android.material.textfield.TextInputLayout
            style="@style/AppTextInputLayout"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:hint="@string/field_sector">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/field_sector"
                style="@style/FieldInput"
                android:inputType="number"
                tools:ignore="Autofill" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <com.google.android.material.textfield.TextInputLayout
            style="@style/AppTextInputLayout"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:hint="@string/field_earfcn">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/field_earfcn"
                style="@style/FieldInput"
                android:inputType="number"
                tools:ignore="Autofill" />
        </com.google.android.material.textfield.TextInputLayout>
        <Space android:layout_width="10dp" android:layout_height="1dp" />
        <com.google.android.material.textfield.TextInputLayout
            style="@style/AppTextInputLayout"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:hint="@string/field_bandwidth">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/field_bandwidth"
                style="@style/FieldInput"
                android:inputType="number"
                tools:ignore="Autofill" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</LinearLayout>
