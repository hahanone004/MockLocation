<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/app_surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:rippleColor="@color/brand_primary_container"
    app:strokeColor="@color/app_outline_variant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="76dp"
        android:orientation="horizontal"
        android:padding="14dp">
        <ImageView
            android:id="@+id/profile_feature_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/switch_panel_background"
            android:contentDescription="@null"
            android:padding="9dp"
            android:tint="@color/brand_primary"
            tools:src="@drawable/baseline_location_on_24" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/profile_feature_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/app_on_surface"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="位置" />
            <TextView
                android:id="@+id/profile_feature_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/app_on_surface_variant"
                android:textSize="12sp"
                tools:text="31.2304, 121.4737 · 抖动 20 米" />
        </LinearLayout>
        <TextView
            android:id="@+id/profile_feature_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="9dp"
            android:paddingTop="5dp"
            android:paddingEnd="9dp"
            android:paddingBottom="5dp"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="已开启" />
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@null"
            android:src="@drawable/baseline_chevron_right_24"
            android:tint="@color/app_on_surface_variant" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
